<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!--
    Message-only stand-in for the upstream livox_ros_driver2 package
    (https://github.com/Livox-SDK/livox_ros_driver2, msg/*.msg copied verbatim).
    The package and message names must match upstream so the DDS type name
    (livox_ros_driver2::msg::dds_::CustomMsg_) is identical; the driver node,
    Livox-SDK2 and PCL are not needed just to subscribe.
  -->
  <name>livox_ros_driver2</name>
  <version>1.2.4</version>
  <description>Livox CustomMsg / CustomPoint message definitions for WebRvizLite's r2r bridge.</description>
  <maintainer email="skylerpan@gmail.com">Skyler Pan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
