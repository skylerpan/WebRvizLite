<?xml version="1.0"?>
<!-- Small differential-drive robot for the mock scene (fixtures/tier1_scene.rviz).
     base_link sits on the ground; the mocks publish base_link → wheel/caster/laser/
     livox_frame/camera_link on /tf_static (what robot_state_publisher would do). -->
<robot name="tier1_robot">
  <material name="body_blue"><color rgba="0.2 0.4 0.9 1.0"/></material>
  <material name="wheel_dark"><color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="sensor_grey"><color rgba="0.6 0.6 0.6 1.0"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.19" rpy="0 0 0"/>
      <geometry><mesh filename="package://webrvizlite_fixtures/robot_description/meshes/body.stl"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.19" rpy="0 0 0"/>
      <geometry><box size="0.6 0.5 0.28"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.19" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.33" ixy="0" ixz="0" iyy="0.44" iyz="0" izz="0.61"/>
    </inertial>
  </link>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><mesh filename="package://webrvizlite_fixtures/robot_description/meshes/wheel.stl"/></geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.127" length="0.05"/></geometry>
    </collision>
    <inertial><mass value="0.8"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.006"/></inertial>
  </link>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><mesh filename="package://webrvizlite_fixtures/robot_description/meshes/wheel.stl"/></geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.127" length="0.05"/></geometry>
    </collision>
    <inertial><mass value="0.8"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.006"/></inertial>
  </link>

  <link name="caster_front_link">
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>

  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="sensor_grey"/>
    </visual>
  </link>

  <link name="livox_frame">
    <visual>
      <geometry><box size="0.08 0.08 0.06"/></geometry>
      <material name="sensor_grey"/>
    </visual>
  </link>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.09 0.03"/></geometry>
      <material name="sensor_grey"/>
    </visual>
  </link>
  <link name="camera_optical_frame"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_left_link"/>
    <origin xyz="0 0.28 0.127" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_right_link"/>
    <origin xyz="0 -0.28 0.127" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/><child link="caster_front_link"/>
    <origin xyz="0.22 0 0.05" rpy="0 0 0"/>
  </joint>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser"/>
    <origin xyz="0.2 0 0.3" rpy="0 0 0"/>
  </joint>
  <joint name="livox_joint" type="fixed">
    <parent link="base_link"/><child link="livox_frame"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.28 0 0.4" rpy="0 0 0"/>
  </joint>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>
</robot>
